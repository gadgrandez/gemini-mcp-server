{
  "name": "@gadgrandez/gemini-mcp-server",
  "version": "3.0.0",
  "description": "MCP server that lets Claude and other MCP clients watch video, listen to audio and read documents through the Gemini API",
  "main": "index.js",
  "type": "module",
  "bin": {
    "gemini-mcp-server": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "tools/"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/server.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "gemini",
    "google-gemini",
    "model-context-protocol",
    "video-understanding",
    "audio-understanding",
    "transcription",
    "multimodal",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gadgrandez/gemini-mcp-server.git"
  },
  "author": "Gad Grandez",
  "contributors": [
    "salviz (original project)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gadgrandez/gemini-mcp-server",
  "bugs": {
    "url": "https://github.com/gadgrandez/gemini-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
